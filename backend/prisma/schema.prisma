// generator client {
//   provider = "prisma-client"
//   output   = "../generated/prisma"
// }

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model atenciones {
  id_atencion                BigInt                       @id @default(autoincrement())
  id_cita                    BigInt                       @unique
  fecha_atencion             DateTime                     @default(now()) @db.Timestamptz(6)
  motivo_atencion            String?
  diagnostico                String?
  notas                      String?
  estado                     String                       @default("EN_PROCESO") @db.VarChar(20)
  registrado_por             BigInt?
  fecha_creacion             DateTime                     @default(now()) @db.Timestamptz(6)
  citas                      citas                        @relation(fields: [id_cita], references: [id_cita], onDelete: NoAction, onUpdate: NoAction)
  usuarios                   usuarios?                    @relation(fields: [registrado_por], references: [id_usuario], onUpdate: NoAction)
  consumo_insumos_atencion   consumo_insumos_atencion[]
  detalle_atencion_servicios detalle_atencion_servicios[]
  movimientos_inventario     movimientos_inventario[]

  @@index([fecha_atencion], map: "idx_atenciones_fecha")
}

model categorias_insumos {
  id_categoria BigInt    @id @default(autoincrement())
  nombre       String    @unique @db.VarChar(80)
  descripcion  String?
  activo       Boolean   @default(true)
  insumos      insumos[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model citas {
  id_cita           BigInt      @id @default(autoincrement())
  id_paciente       BigInt
  id_medico         BigInt
  fecha_hora_inicio DateTime    @db.Timestamptz(6)
  fecha_hora_fin    DateTime    @db.Timestamptz(6)
  motivo            String?     @db.VarChar(300)
  estado            String      @default("PROGRAMADA") @db.VarChar(20)
  observaciones     String?
  creado_por        BigInt?
  fecha_creacion    DateTime    @default(now()) @db.Timestamptz(6)
  atenciones        atenciones?
  usuarios          usuarios?   @relation(fields: [creado_por], references: [id_usuario], onUpdate: NoAction)
  medicos           medicos     @relation(fields: [id_medico], references: [id_medico], onDelete: NoAction, onUpdate: NoAction)
  pacientes         pacientes   @relation(fields: [id_paciente], references: [id_paciente], onDelete: NoAction, onUpdate: NoAction)

  @@index([estado, fecha_hora_inicio], map: "idx_citas_estado_fecha")
  @@index([id_medico, fecha_hora_inicio], map: "idx_citas_medico_fecha")
  @@index([id_paciente, fecha_hora_inicio], map: "idx_citas_paciente_fecha")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model consumo_insumos_atencion {
  id_consumo             BigInt                  @id @default(autoincrement())
  id_atencion            BigInt
  id_insumo              BigInt
  cantidad               Decimal                 @db.Decimal(12, 2)
  fecha_consumo          DateTime                @default(now()) @db.Timestamptz(6)
  registrado_por         BigInt?
  observaciones          String?
  atenciones             atenciones              @relation(fields: [id_atencion], references: [id_atencion], onDelete: NoAction, onUpdate: NoAction)
  insumos                insumos                 @relation(fields: [id_insumo], references: [id_insumo], onDelete: NoAction, onUpdate: NoAction)
  usuarios               usuarios?               @relation(fields: [registrado_por], references: [id_usuario], onUpdate: NoAction)
  movimientos_inventario movimientos_inventario?

  @@index([id_atencion], map: "idx_consumo_atencion")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalle_atencion_servicios {
  id_detalle              BigInt                  @id @default(autoincrement())
  id_atencion             BigInt
  id_servicio             BigInt
  cantidad                Decimal                 @default(1) @db.Decimal(10, 2)
  observaciones           String?
  atenciones              atenciones              @relation(fields: [id_atencion], references: [id_atencion], onDelete: NoAction, onUpdate: NoAction)
  servicios_hospitalarios servicios_hospitalarios @relation(fields: [id_servicio], references: [id_servicio], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_atencion, id_servicio], map: "uq_atencion_servicio")
  @@index([id_atencion], map: "idx_detalle_servicios_atencion")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model insumos {
  id_insumo                BigInt                     @id @default(autoincrement())
  id_categoria             BigInt
  codigo                   String                     @unique @db.VarChar(40)
  nombre                   String                     @db.VarChar(150)
  descripcion              String?
  unidad_medida            String                     @db.VarChar(30)
  stock_actual             Decimal                    @default(0) @db.Decimal(12, 2)
  stock_minimo             Decimal                    @default(0) @db.Decimal(12, 2)
  activo                   Boolean                    @default(true)
  consumo_insumos_atencion consumo_insumos_atencion[]
  categorias_insumos       categorias_insumos         @relation(fields: [id_categoria], references: [id_categoria], onDelete: NoAction, onUpdate: NoAction)
  movimientos_inventario   movimientos_inventario[]

  @@index([id_categoria], map: "idx_insumos_categoria")
  @@index([stock_actual, stock_minimo], map: "idx_insumos_stock")
}

model medicos {
  id_medico      BigInt   @id @default(autoincrement())
  id_usuario     BigInt   @unique
  identificacion String   @unique @db.VarChar(40)
  nombre         String   @db.VarChar(80)
  apellido       String   @db.VarChar(100)
  especialidad   String   @db.VarChar(100)
  telefono       String?  @db.VarChar(30)
  correo         String?  @db.VarChar(254)
  activo         Boolean  @default(true)
  citas          citas[]
  usuarios       usuarios @relation(fields: [id_usuario], references: [id_usuario], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model movimientos_inventario {
  id_movimiento            BigInt                    @id @default(autoincrement())
  id_insumo                BigInt
  tipo_movimiento          String                    @db.VarChar(20)
  cantidad                 Decimal                   @db.Decimal(12, 2)
  fecha_movimiento         DateTime                  @default(now()) @db.Timestamptz(6)
  motivo                   String                    @db.VarChar(250)
  id_atencion              BigInt?
  id_consumo               BigInt?                   @unique
  registrado_por           BigInt?
  atenciones               atenciones?               @relation(fields: [id_atencion], references: [id_atencion], onDelete: Restrict, onUpdate: NoAction)
  consumo_insumos_atencion consumo_insumos_atencion? @relation(fields: [id_consumo], references: [id_consumo], onDelete: Restrict, onUpdate: NoAction)
  insumos                  insumos                   @relation(fields: [id_insumo], references: [id_insumo], onDelete: NoAction, onUpdate: NoAction)
  usuarios                 usuarios?                 @relation(fields: [registrado_por], references: [id_usuario], onUpdate: NoAction)

  @@index([id_insumo, fecha_movimiento(sort: Desc)], map: "idx_movimientos_insumo_fecha")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pacientes {
  id_paciente      BigInt    @id @default(autoincrement())
  identificacion   String    @unique @db.VarChar(40)
  nombre           String    @db.VarChar(80)
  apellido         String    @db.VarChar(100)
  fecha_nacimiento DateTime? @db.Date
  telefono         String?   @db.VarChar(30)
  correo           String?   @db.VarChar(254)
  direccion        String?   @db.VarChar(250)
  fecha_registro   DateTime  @default(now()) @db.Timestamptz(6)
  activo           Boolean   @default(true)
  citas            citas[]
}

model roles {
  id_rol      BigInt     @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(50)
  descripcion String?    @db.VarChar(250)
  activo      Boolean    @default(true)
  usuarios    usuarios[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model servicios_hospitalarios {
  id_servicio                BigInt                       @id @default(autoincrement())
  codigo                     String                       @unique @db.VarChar(30)
  nombre                     String                       @unique @db.VarChar(120)
  descripcion                String?
  duracion_estimada_minutos  Int?
  activo                     Boolean                      @default(true)
  detalle_atencion_servicios detalle_atencion_servicios[]
}

model usuarios {
  id_usuario               BigInt                     @id @default(autoincrement())
  id_rol                   BigInt
  nombre_usuario           String                     @unique @db.VarChar(60)
  correo                   String                     @unique @db.VarChar(254)
  password_hash            String
  nombre_completo          String                     @db.VarChar(150)
  activo                   Boolean                    @default(true)
  fecha_creacion           DateTime                   @default(now()) @db.Timestamptz(6)
  atenciones               atenciones[]
  citas                    citas[]
  consumo_insumos_atencion consumo_insumos_atencion[]
  medicos                  medicos?
  movimientos_inventario   movimientos_inventario[]
  roles                    roles                      @relation(fields: [id_rol], references: [id_rol], onDelete: NoAction, onUpdate: NoAction)
}

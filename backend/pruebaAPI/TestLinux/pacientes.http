################################
###### RESTO DEL CRUD ##########
################################
@idPaciente = 1

### READ - Listar todos
GET {{baseUrl}}/pacientes
Authorization: Bearer {{token}}


### READ - Listar activos
GET {{baseUrl}}/pacientes?activo=true
Authorization: Bearer {{token}}


### READ - Listar inactivos
GET {{baseUrl}}/pacientes?activo=false
Authorization: Bearer {{token}}


### READ - Consultar por ID
GET {{baseUrl}}/pacientes/{{idPaciente}}
Authorization: Bearer {{token}}


### UPDATE - Actualizar paciente
PUT {{baseUrl}}/pacientes/{{idPaciente}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Anita",
  "apellido": "Martinez Urb",
  "identificacion": "23542521",
  "fecha_nacimiento": "1997-08-11",
  "telefono": "278392746",
  "correo": "anita.actualizada@example.com"
}


### DELETE - Eliminación lógica
DELETE {{baseUrl}}/pacientes/{{idPaciente}}
Authorization: Bearer {{token}}


### PATCH - Activar paciente
PATCH {{baseUrl}}/pacientes/{{idPaciente}}/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "activo": true
}


### PATCH - Desactivar paciente
PATCH {{baseUrl}}/pacientes/{{idPaciente}}/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "activo": false
}

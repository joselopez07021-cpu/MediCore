# auth.http
@baseUrl = http://localhost:3000/api
@token = {{login.response.body.data.token}}

### Login administrador
# @name login
# @prompt demoPassword Contraseña local del usuario de demostración
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "nombre_usuario": "admin.demo",
  "password": "{{demoPassword}}"
}

### Login Recepcion - ADMISION
# @name loginAlternativo2
# @prompt demoPassword Contraseña local del usuario de demostración
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "nombre_usuario": "recepcion.demo",
  "password": "{{demoPassword}}"
}


### Login médico
# @name loginAlternativo3
# @prompt demoPassword Contraseña local del usuario de demostración
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "nombre_usuario": "elena.soto",
  "password": "{{demoPassword}}"
}

### Login Inventario
# @name loginAlternativo4
# @prompt demoPassword Contraseña local del usuario de demostración
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "nombre_usuario": "inventario.demo",
  "password": "{{demoPassword}}"
}


### 2. Consultar usuario autenticado
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}


### 3. Ruta exclusiva de administradores
GET {{baseUrl}}/auth/admin-test
Authorization: Bearer {{token}}


### 4. Ruta exclusiva de médicos
GET {{baseUrl}}/auth/medical-test
Authorization: Bearer {{token}}


### 5. Probar acceso sin autenticación
GET {{baseUrl}}/auth/me

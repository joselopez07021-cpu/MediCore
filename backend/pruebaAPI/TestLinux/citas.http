@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3OTUxOTQxODgsImV4cCI6MTc5NTE5Nzc4OCwic3ViIjoiMiJ9.W9NCcYiH6c_Dp-5V_Ttgpi7zOgaXO05S5jNxSOxk2ac
@idCita = 1

### Login Recepcion - ADMISION
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "nombre_usuario": "recepcion.demo",
  "password": "Recepcion123!"
}

### Registrar cita médica
POST {{baseUrl}}/citas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_paciente": "3",
  "id_medico": "1",
  "fecha": "2026-11-20",
  "hora": "19:30",
  "motivo": "Consulta de medicina general",
  "estado": "PROGRAMADA"
}


### Probar conflicto de horario
POST {{baseUrl}}/citas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_paciente": "2",
  "id_medico": "1",
  "fecha": "2026-11-20",
  "hora": "19:45",
  "motivo": "Consulta de seguimiento",
  "estado": "PROGRAMADA"
}


### Probar otro horario disponible
POST {{baseUrl}}/citas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_paciente": "2",
  "id_medico": "1",
  "fecha": "2026-11-20",
  "hora": "12:00",
  "motivo": "Consulta de seguimiento",
  "estado": "PROGRAMADA"
}


### READ - Todas las citas
GET {{baseUrl}}/citas
Authorization: Bearer {{token}}


### Citas - Página 1
GET {{baseUrl}}/citas/paginados?page=1
Authorization: Bearer {{token}}

### Citas - Página 2
GET {{baseUrl}}/citas/paginados?page=2
Authorization: Bearer {{token}}


### READ - Cita específica
GET {{baseUrl}}/citas/{{idCita}}
Authorization: Bearer {{token}}


### UPDATE - Editar cita
PUT {{baseUrl}}/citas/{{idCita}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_paciente": "3",
  "id_medico": "1",
  "fecha": "2026-11-20",
  "hora": "10:30",
  "motivo": "Consulta de seguimiento",
  "estado": "PROGRAMADA"
}


### PATCH - Confirmar cita
PATCH {{baseUrl}}/citas/{{idCita}}/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "CONFIRMADA"
}


### PATCH - Cancelar cita
PATCH {{baseUrl}}/citas/{{idCita}}/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "CANCELADA"
}

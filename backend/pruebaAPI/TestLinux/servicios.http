@baseUrl = http://localhost:3000/api
@token = {{login.response.body.data.token}}

### Login administrador
# @name login
# @prompt demoPassword Contraseña local del usuario de demostración
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "nombre_usuario": "admin.demo",
  "password": "{{demoPassword}}"
}


### Catálogo completo
GET {{baseUrl}}/atenciones/servicios
Authorization: Bearer {{token}}

### Filtrar cardiología
GET {{baseUrl}}/atenciones/servicios?buscar=cardio
Authorization: Bearer {{token}}

### Filtrar consultas
GET {{baseUrl}}/atenciones/servicios?buscar=consulta
Authorization: Bearer {{token}}

# Copiar a .env y completar con valores locales. Nunca subir .env.
DATABASE_URL="postgresql://postgres:TU_CONTRASENA@localhost:5432/medicore_demo"
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:4200"
# Generar un valor propio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="1h"

# Contraseñas de usuarios ficticios: completar localmente antes de dbSeed.
# Las semillas conservan los usuarios existentes y no cambian sus contraseñas.
DEMO_ADMIN_PASSWORD=""
DEMO_ADMISION_PASSWORD=""
DEMO_MEDICO_PASSWORD=""
DEMO_INVENTARIO_PASSWORD=""

table fact_movimientos
	lineageTag: eeb62c9a-af4c-4b89-b8de-8dcb65341af8

	measure Movimientos = COUNTROWS(fact_movimientos)
		formatString: 0
		lineageTag: ae89b286-9caf-49b8-b7bb-120317338617

	measure 'Entradas inventario' =
			CALCULATE(
			    [Movimientos],
			    fact_movimientos[tipo_movimiento] = "ENTRADA"
			)
		formatString: 0
		lineageTag: de257999-db85-41aa-8f3b-4057e7b1a111

	measure 'Salidas inventario' =
			CALCULATE(
			    [Movimientos],
			    fact_movimientos[tipo_movimiento] = "SALIDA"
			)
		formatString: 0
		lineageTag: fc8d1446-629c-49d5-8bee-4d3b00966f42

	measure 'Cantidad entradas' =
			IF(
			    HASONEVALUE(dim_insumos[unidad_medida]),
			    CALCULATE(
			        SUM(fact_movimientos[cantidad]),
			        fact_movimientos[tipo_movimiento] = "ENTRADA"
			    ),
			    BLANK()
			)
		lineageTag: 37b9d0c4-0943-40ef-a223-0c56291a057e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cantidad salidas' =
			IF(
			    HASONEVALUE(dim_insumos[unidad_medida]),
			    CALCULATE(
			        SUM(fact_movimientos[cantidad]),
			        fact_movimientos[tipo_movimiento] = "SALIDA"
			    ),
			    BLANK()
			)
		lineageTag: 6e6d5ef2-405f-446c-89f7-b7c01b3421b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}


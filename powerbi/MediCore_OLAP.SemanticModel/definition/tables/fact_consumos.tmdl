table fact_consumos
	lineageTag: 13a21992-fa84-46ff-871d-e6f2447c0a48

	measure 'Total registros consumo' = COUNTROWS(fact_consumos)
		formatString: 0
		lineageTag: 0b059f43-dda7-4d78-8ffd-a85a3ef4b132

	measure Consumo =
			IF(
			    HASONEVALUE(dim_insumos[unidad_medida]),
			    SUM(fact_consumos[cantidad]),
			    BLANK()
			)
		lineageTag: 80d04b46-54ad-4526-a030-fca2fa859864

		annotation PBI_FormatHint = {"isGeneralNumber":true}


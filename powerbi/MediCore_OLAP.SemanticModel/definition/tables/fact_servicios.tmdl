table fact_servicios
	lineageTag: c40cf5cb-397f-43d0-b8b2-2f1692c86542

	measure 'Servicios realizados' = SUM(fact_servicios[cantidad])
		lineageTag: 59a1d3e8-67ff-44c1-8fa6-6eff3caf54ec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Promedio servicios' =
			DIVIDE(
			    [Servicios realizados],
			    [Total atenciones],
			    0
			)
		formatString: 0.00
		lineageTag: 08429153-ee92-416d-ad15-b50e3857664e


		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 2d6169ee-d6e4-4f65-bfcd-679941ffcf16
		summarizeBy: none
		sourceColumn: activo

		annotation SummarizationSetBy = Automatic

	partition dim_insumos = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database("localhost:5433", "medicore"),
				    analitica_dim_insumos = Origen{[Schema="analitica",Item="dim_insumos"]}[Data]
				in
				    analitica_dim_insumos

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table


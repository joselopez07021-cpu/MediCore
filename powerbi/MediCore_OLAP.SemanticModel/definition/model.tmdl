model Model
	culture: es-CR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-CR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["dim_fecha","dim_insumos","dim_medicos","dim_servicios","fact_atenciones","fact_citas","fact_consumos","fact_movimientos","fact_servicios"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_fecha
ref table dim_insumos
ref table dim_medicos
ref table dim_servicios
ref table fact_atenciones
ref table fact_citas
ref table fact_consumos
ref table fact_movimientos
ref table fact_servicios

ref cultureInfo es-CR

